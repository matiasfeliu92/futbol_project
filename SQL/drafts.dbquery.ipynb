   "source": [
    "SELECT\n",
    "    date,\n",
    "    name,\n",
    "    league,\n",
    "    match[0].awayTeam.name AS away_team,\n",
    "    match[0].homeTeam.name AS home_team\n",
    "FROM \n",
    "    parquet.`/Volumes/workspace/futbol/futbol_landing/`\n",
    "WHERE \n",
    "    match[0].awayTeam.name LIKE 'Racing%'\n",
    "    OR\n",
    "    match[0].homeTeam.name LIKE 'Racing%'"
   ]
  }
 ],
